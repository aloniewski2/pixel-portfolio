# All optional — the site works with none of these set.
# Only needed if you deploy api/chat.js and want the PUBLIC site to answer.

# Any OpenAI-compatible endpoint. Local default:
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2

# Leave unset for local models. Only needed for a hosted provider.
# LLM_API_KEY=

# Recommended for the public site (free, no card): Groq.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# LLM_REASONING_EFFORT=low

# Sites allowed to call the endpoint cross-origin (comma-separated).
# ALLOWED_ORIGINS=https://aloniewski2.github.io,https://andrewloniewski.vercel.app
